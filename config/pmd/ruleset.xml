<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="BidMart PMD Rules (Main)"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.net/ruleset_2_0_0.xsd">

  <description>PMD rules for production/main source set.</description>

  <rule ref="category/java/bestpractices.xml">
    <!-- String constants in annotations (e.g. @RequestHeader) are idiomatic Spring, bukan code smell -->
    <exclude name="AvoidDuplicateLiterals"/>
  </rule>

  <rule ref="category/java/design.xml">
    <exclude name="LoosePackageCoupling"/>
    <exclude name="UseUtilityClass"/>
    <exclude name="SignatureDeclareThrowsException"/>
    <!-- DTO/Model/Response classes wajar punya banyak field -->
    <exclude name="TooManyFields"/>
  </rule>

  <rule ref="category/java/errorprone.xml">
    <!-- Exception custom yang extend RuntimeException tidak perlu serialVersionUID -->
    <exclude name="MissingSerialVersionUID"/>
  </rule>

</ruleset>